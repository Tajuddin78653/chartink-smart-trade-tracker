# ── Database ───────────────────────────────────────────
POSTGRES_PASSWORD=cstt_secure_pass_change_me

# ── Redis ──────────────────────────────────────────────
REDIS_PASSWORD=cstt_redis_pass_change_me

# ── N8N ────────────────────────────────────────────────
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_USER=admin
N8N_PASSWORD=n8n_secure_pass_change_me
N8N_WEBHOOK_URL=http://localhost:5678

# ── Backend ────────────────────────────────────────────
NODE_ENV=production
JWT_SECRET=your_super_secret_jwt_key_change_me
API_URL=http://localhost:4000
WS_URL=ws://localhost:4000

# ── Broker API (choose one) ────────────────────────────
BROKER=dhan
DHAN_ACCESS_TOKEN=your_dhan_token
DHAN_CLIENT_ID=your_dhan_client_id

